#include <winres.h>
#include "resource.h"

#ifndef MOVEABLE_VERSION_STR
#define MOVEABLE_VERSION_STR "0.0.0"
#define MOVEABLE_VERSION_COMMA 0,0,0,0
#endif

IDI_APP ICON "moveable.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MOVEABLE_VERSION_COMMA
 PRODUCTVERSION MOVEABLE_VERSION_COMMA
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Moveable"
            VALUE "FileDescription", "Moveable - move and resize the focused window from the keyboard"
            VALUE "FileVersion", MOVEABLE_VERSION_STR
            VALUE "InternalName", "Moveable"
            VALUE "OriginalFilename", "Moveable.exe"
            VALUE "ProductName", "Moveable"
            VALUE "ProductVersion", MOVEABLE_VERSION_STR
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
