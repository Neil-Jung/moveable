#include <winres.h>
#include "resource.h"

IDI_APP ICON "moveable.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Moveable"
            VALUE "FileDescription", "Moveable - glide the focused window with Ctrl+Alt+Shift+Arrows"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "Moveable"
            VALUE "OriginalFilename", "Moveable.exe"
            VALUE "ProductName", "Moveable"
            VALUE "ProductVersion", "1.1.0"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
